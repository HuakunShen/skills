{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:audit-claims:v1",
  "title": "Audit Claims v1 record definitions",
  "description": "Logical record definitions for claim audits. Validate each ledger with its matching $defs entry. Root union covers the core analysis records; adapter-specific fields may extend records.",
  "oneOf": [
    {
      "$ref": "#/$defs/claim"
    },
    {
      "$ref": "#/$defs/occurrence"
    },
    {
      "$ref": "#/$defs/evidence"
    },
    {
      "$ref": "#/$defs/coverage"
    },
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/task"
    }
  ],
  "$defs": {
    "criteria": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "definition": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "predicate": {
              "type": "string",
              "minLength": 1
            },
            "window_start": {
              "type": [
                "string",
                "null"
              ]
            },
            "window_end": {
              "type": [
                "string",
                "null"
              ]
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "condition": {
              "type": [
                "string",
                "object"
              ]
            },
            "resolution_basis": {
              "enum": [
                "explicit",
                "interpretation"
              ]
            },
            "interpretation_notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "target",
            "predicate",
            "window_start",
            "window_end",
            "timezone",
            "condition",
            "resolution_basis"
          ],
          "additionalProperties": true
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "frozen_at",
        "definition",
        "sha256"
      ],
      "additionalProperties": true
    },
    "evidence_quality": {
      "type": "object",
      "properties": {
        "directness": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "independence": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "traceability": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "directness",
        "independence",
        "traceability"
      ],
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "occurrence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": [
            "factual",
            "prediction",
            "causal",
            "recommendation",
            "value_judgment",
            "preference",
            "hypothetical",
            "rhetorical",
            "reported",
            "ambiguous"
          ]
        },
        "quantifiability": {
          "enum": [
            "numeric",
            "operationalizable",
            "qualitative",
            "none",
            "unclear"
          ]
        },
        "verifiability": {
          "enum": [
            "verifiable",
            "conditional",
            "unverifiable",
            "unclear"
          ]
        },
        "empirical": {
          "type": "boolean"
        },
        "endorsement": {
          "enum": [
            "endorsed",
            "quoted",
            "rejected",
            "mocked",
            "unclear"
          ]
        },
        "attribution_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "accountability_eligible": {
          "type": "boolean"
        },
        "criteria": {
          "anyOf": [
            {
              "$ref": "#/$defs/criteria"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle": {
          "enum": [
            "pending",
            "ready",
            "awaiting_evidence",
            "resolved",
            "unscorable",
            "disputed"
          ]
        },
        "outcome": {
          "enum": [
            "supported",
            "contradicted",
            "mixed",
            "indeterminate",
            null
          ]
        },
        "reason": {
          "type": "string"
        },
        "due_for_assessment": {
          "type": "boolean"
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "next_check_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evaluation_mode": {
          "enum": [
            "categorical",
            "probabilistic",
            "none"
          ]
        },
        "probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "probability_origin": {
          "enum": [
            "explicit",
            "inferred",
            "none"
          ]
        },
        "event_occurred": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence_quality"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_state": {
          "enum": [
            "unreviewed",
            "accepted",
            "needs_review"
          ]
        },
        "acceptance": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "decision_path": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "policy_hash": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "decision_path",
                "decision_sha256",
                "policy_hash"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "family_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "first_stated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "difficulty": {
          "enum": [
            "trivial",
            "moderate",
            "hard",
            "non_consensus",
            null
          ]
        },
        "difficulty_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "difficulty_rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_exception": {
          "type": "object",
          "required": [
            "reviewed",
            "reason"
          ],
          "properties": {
            "reviewed": {
              "const": true
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "citation_status": {
          "description": "Sourcing rigor of the speaker's assertion: primary_cited = locatable primary source; secondary_cited = media/unnamed/vague third party; uncited_specific = concrete figure or date with no citation; uncited_vague = vague unverifiable assertion with no citation or anchor.",
          "enum": [
            "primary_cited",
            "secondary_cited",
            "uncited_specific",
            "uncited_vague",
            null
          ]
        },
        "citation_text": {
          "description": "Exact source phrase the speaker used to cite, or null when none.",
          "type": [
            "string",
            "null"
          ]
        },
        "cited_source_tier": {
          "description": "Source tier of what the speaker cites for this assertion (claim-level; scoring reads this field): authoritative_primary = official/primary record; reputable_media = established outlet naming its source; low_credibility_or_rumor = tabloid, aggregator or unverifiable rumor; unnamed_insider = 据消息人士/知情人士 with no named source; none = no source cited. Null = untagged (legacy).",
          "enum": [
            "authoritative_primary",
            "reputable_media",
            "low_credibility_or_rumor",
            "unnamed_insider",
            "none",
            null
          ]
        }
      },
      "required": [
        "schema_version",
        "claim_id",
        "subject_id",
        "occurrence_ids",
        "text",
        "domain",
        "claim_type",
        "quantifiability",
        "verifiability",
        "empirical",
        "endorsement",
        "attribution_confidence",
        "accountability_eligible",
        "criteria",
        "lifecycle",
        "outcome",
        "due_for_assessment",
        "evaluation_mode",
        "probability",
        "probability_origin",
        "event_occurred",
        "evidence_ids",
        "evidence_quality",
        "review_state"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "required": [
              "resolved_at"
            ],
            "properties": {
              "criteria": {
                "$ref": "#/$defs/criteria"
              },
              "resolved_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_ids": {
                "minItems": 1
              },
              "due_for_assessment": {
                "const": true
              },
              "evaluation_mode": {
                "enum": [
                  "categorical",
                  "probabilistic"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "due_for_assessment": {
                "const": false
              },
              "outcome": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "not": {
                  "const": "resolved"
                }
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "accountability_eligible": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "empirical": {
                "const": true
              },
              "criteria": {
                "$ref": "#/$defs/criteria"
              },
              "verifiability": {
                "enum": [
                  "verifiable",
                  "conditional"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "probability_origin": {
                "const": "explicit"
              }
            }
          },
          "then": {
            "properties": {
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evaluation_mode": {
                "const": "probabilistic"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "probability_origin": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "probability": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "resolved"
              },
              "evaluation_mode": {
                "const": "categorical"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "supported",
                  "contradicted",
                  "mixed",
                  "indeterminate"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "resolved"
              },
              "evaluation_mode": {
                "const": "probabilistic"
              }
            }
          },
          "then": {
            "properties": {
              "event_occurred": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "enum": [
                  "value_judgment",
                  "preference",
                  "hypothetical",
                  "rhetorical"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "empirical": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "due_for_assessment": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "accountability_eligible": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "resolved"
              },
              "review_state": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "required": [
              "acceptance"
            ],
            "properties": {
              "acceptance": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "occurrence": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "occurrence_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "original_quote": {
          "type": "string",
          "minLength": 1
        },
        "context_before": {
          "type": "string"
        },
        "context_after": {
          "type": "string"
        },
        "locator": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "timestamp",
                "cue",
                "paragraph",
                "character",
                "page"
              ]
            },
            "start": {
              "type": [
                "number",
                "string"
              ]
            },
            "end": {
              "type": [
                "number",
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "additionalProperties": true
        },
        "endorsement": {
          "enum": [
            "endorsed",
            "quoted",
            "rejected",
            "mocked",
            "unclear"
          ]
        },
        "language": {
          "type": [
            "string",
            "array"
          ]
        },
        "technical_duplicate_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "cited_source_tier": {
          "description": "Optional copy of the claim's cited_source_tier for this quote (informational; score_claims.py scores the claim-level value).",
          "enum": [
            "authoritative_primary",
            "reputable_media",
            "low_credibility_or_rumor",
            "unnamed_insider",
            "none",
            null
          ]
        }
      },
      "required": [
        "schema_version",
        "occurrence_id",
        "claim_id",
        "source_id",
        "speaker",
        "original_quote",
        "context_before",
        "context_after",
        "locator",
        "endorsement",
        "language"
      ],
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "available_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observation_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "context"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "excerpt": {
          "type": "string"
        },
        "structured_data": {},
        "source_family": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "evidence_id",
        "title",
        "retrieved_at",
        "published_at",
        "available_at",
        "relation",
        "claim_ids",
        "source_family"
      ],
      "anyOf": [
        {
          "required": [
            "source_url"
          ]
        },
        {
          "required": [
            "local_path"
          ]
        }
      ],
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "eligible_sources": {
          "type": "integer",
          "minimum": 0
        },
        "acquired_sources": {
          "type": "integer",
          "minimum": 0
        },
        "extracted_sources": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_complete": {
          "type": "boolean"
        },
        "unresolved_review_issues": {
          "type": "integer",
          "minimum": 0
        },
        "sampling": {
          "type": "string"
        },
        "exclusion_counts": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "eligible_sources",
        "acquired_sources",
        "extracted_sources",
        "inventory_complete",
        "unresolved_review_issues"
      ],
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "title": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "pending",
            "failed",
            "skipped",
            "truncated"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "array",
            "null"
          ]
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "media_duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "transcription": {
          "type": [
            "object",
            "null"
          ]
        },
        "quality_flags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "source_id",
        "status"
      ],
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "input_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "payload_path": {
          "type": "string",
          "minLength": 1
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "blocked"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "result_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "task_id",
        "stage",
        "input_fingerprint",
        "payload_path",
        "payload_hash",
        "dependencies",
        "status",
        "attempts"
      ],
      "additionalProperties": true
    },
    "source_access": {
      "type": "object",
      "required": [
        "access_id",
        "request_kind",
        "attempted_at",
        "outcome"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "access_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
