// Pattern C - one package, two shapes: a custom export condition; workspace consumers get source, npm users get the build output.
// From uniview/packages/protocol/package.json (full file, read 2026-10-05; 8 packages in uniview use this pattern).
// publishConfig strips the uniview-source condition at publish time, leaving only the dist paths.
{
  "name": "@uniview/protocol",
  "type": "module",
  "sideEffects": false,
  "version": "0.0.1",
  "description": "Protocol types and schemas for the Uniview plugin system",
  "license": "MIT",
  "exports": {
    ".": {
      "uniview-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "uniview-source": "./src/core.ts",
      "default": "./dist/core.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./core": "./dist/core.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "0.22.2",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
